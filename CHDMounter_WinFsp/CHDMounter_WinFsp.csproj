<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <PublishSingleFile>true</PublishSingleFile>
        <!-- Framework-dependent on purpose: the release bundle must not embed the .NET runtime. -->
        <SelfContained>false</SelfContained>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
        <!-- Required: WinFsp.NET's Fsp.Interop.Api reads its own assembly Location to load the
             native DLL and verify its version. In a single-file bundle Location is empty, which
             makes the static initializer throw TypeInitializationException ("The type initializer
             for 'Fsp.Interop.Api' threw an exception", bugs 67653-67656, 67777/67778). Extracting
             all content puts winfsp-msil.dll on disk and lets the bindings initialize. -->
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
        <PublishDocumentationFiles>false</PublishDocumentationFiles>
        <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>

        <AssemblyVersion>1.2.1</AssemblyVersion>
        <FileVersion>1.2.1</FileVersion>
        <NeutralLanguage>en</NeutralLanguage>
        <Company>PureLogicCode.com</Company>
        <ApplicationIcon>Icon\chd.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\CHDMounter.Core\CHDMounter.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Meziantou.Analyzer" Version="3.0.297">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="winfsp.net" Version="2.1.25156" />
        <PackageReference Include="WPF-UI" Version="4.3.0" />
    </ItemGroup>

</Project>