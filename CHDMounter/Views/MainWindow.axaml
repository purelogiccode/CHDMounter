<Window x:Class="CHDMounter.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vgfsp="clr-namespace:VideoGameFileSystemParser.Models;assembly=VideoGameFileSystemParser"
        Title="CHDMounter (Dokan)"
        Height="500" Width="800"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Icon="/Icon/chd.ico"
        ToolTip.Tip="CHDMounter main window">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
        <Menu Grid.Row="0" Margin="0" ToolTip.Tip="Application menu bar">
            <MenuItem Header="File" ToolTip.Tip="File operations">
                <MenuItem Header="Open CHD..." Click="OpenChd_Click"
                          ToolTip.Tip="Select a CHD disc image file to mount" />
                <Separator ToolTip.Tip="Menu item separator" />
                <MenuItem Header="Settings" Click="Settings_Click" ToolTip.Tip="Open the settings window" />
                <Separator ToolTip.Tip="Menu item separator" />
                <MenuItem Header="Exit" Click="Exit_Click" ToolTip.Tip="Close the application" />
            </MenuItem>
            <MenuItem Header="Help" ToolTip.Tip="Help and information">
                <MenuItem Header="Open AppData Folder" Click="OpenAppDataFolder_Click"
                          ToolTip.Tip="Open the application data folder in the file manager" />
                <Separator ToolTip.Tip="Menu item separator" />
                <MenuItem Header="About" Click="About_Click" ToolTip.Tip="About CHDMounter" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="10,8" ToolTip.Tip="CHD file and console selection controls"
              ColumnDefinitions="Auto,*,Auto,Auto,Auto">
            <Label Grid.Column="0" Content="CHD File:" VerticalAlignment="Center"
                   ToolTip.Tip="Label for the CHD file path field" />
            <TextBox Grid.Column="1" x:Name="ChdFilePathTextBox" Margin="6,0" VerticalAlignment="Center"
                     TextChanged="ChdFilePath_TextChanged"
                     ToolTip.Tip="Path to the CHD disc image file" />
            <Button Grid.Column="2" Content="Browse..." Click="BrowseChd_ClickAsync" Width="100" Margin="6,0"
                    ToolTip.Tip="Browse for a CHD disc image file" />

            <Label Grid.Column="3" Content="Console:" VerticalAlignment="Center" Margin="12,0,6,0"
                   ToolTip.Tip="Label for the console type selector" />
            <ComboBox Grid.Column="4" x:Name="ConsoleTypeComboBox" Width="220"
                      VerticalAlignment="Center" SelectionChanged="ConsoleType_SelectionChanged"
                      ToolTip.Tip="Select the video game console filesystem type">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vgfsp:ConsoleInfo">
                        <TextBlock Text="{Binding Name}" ToolTip.Tip="Console type display name" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="10,0,10,8" ToolTip.Tip="Mount and unmount controls"
              ColumnDefinitions="Auto,Auto,*">
            <Button Grid.Column="0" x:Name="MountButton" Content="Mount" Width="100"
                    Click="Mount_ClickAsync" IsEnabled="False" ToolTip.Tip="Mount the CHD file as a virtual drive" />
            <Button Grid.Column="1" x:Name="UnmountButton" Content="Unmount" Width="100"
                    Margin="8,0" IsEnabled="False"
                    Click="Unmount_ClickAsync" ToolTip.Tip="Unmount the virtual drive" />
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource BgPrimaryBrush}" Margin="10,0,10,8"
                ToolTip.Tip="Activity log output">
            <ScrollViewer x:Name="LogScrollViewer" Padding="10"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          ToolTip.Tip="Scrollable area for the activity log">
                <SelectableTextBlock x:Name="LogTextBlock" TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonospaceFontFamily}" FontSize="12"
                                     Foreground="{StaticResource TextSecondaryBrush}"
                                     ToolTip.Tip="Activity log messages" />
            </ScrollViewer>
        </Border>

        <Border Grid.Row="4" Background="{StaticResource BgSecondaryBrush}"
                ToolTip.Tip="Application status bar">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ToolTip.Tip="Status bar content">
                <TextBlock Grid.Column="0" x:Name="StatusText" Text="Ready" Margin="12,4"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           ToolTip.Tip="Displays the current status of the application" />
                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderPrimaryBrush}"
                        Margin="0,3" ToolTip.Tip="Status bar separator" />
                <TextBlock Grid.Column="3" x:Name="DriveLetterText" Text="" Margin="12,4"
                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                           ToolTip.Tip="Current mounted drive letter" />
            </Grid>
        </Border>
    </Grid>
</Window>
